# Copy this file to .env.local (or .env) and fill in your own values.
# Real env files are ignored by git; never commit keys.
# Find both values in Supabase: Project Settings → API Keys (or the Connect button).

# Your project's address, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (starts with sb_publishable_). Safe in the browser:
# Row Level Security limits what it can do. Never put the secret key
# (sb_secret_...) in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, for automated end-to-end checks only: a throwaway test account
# (Supabase → Authentication → Users → Add user, "Auto Confirm User").
# No NEXT_PUBLIC_ prefix, so these never reach the browser.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
